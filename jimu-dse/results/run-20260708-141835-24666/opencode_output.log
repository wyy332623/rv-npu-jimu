        diff = np.abs(actual - ref)
        max_diff = float(np.max(diff))
        mean_diff = float(np.mean(diff))
        print(f"  {label} {name}: max_diff={max_diff:.6f}, mean_diff={mean_diff:.6f}")
        warnings = 0
