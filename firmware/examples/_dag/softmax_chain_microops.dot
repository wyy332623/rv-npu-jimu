  n6 [label="6: MAT_LOAD (2 instr)\nDRAM[0x700]" fillcolor="wheat"];
  n7 [label="7: MV_MUL (3 instr)" fillcolor="gold"];
  n8 [label="8: INST_ISSUE" fillcolor="white"];
  n9 [label="9: DRAM_STORE (2 instr)\nDRAM[0x2100]" fillcolor="lightblue"];
