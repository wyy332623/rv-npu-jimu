digraph sym_graph {
  rankdir=LR;
  node [shape=plaintext style=filled fillcolor=white];
  edge [fontsize=10];
  fontname="monospace";
  n0 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>MVM_Q</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>Q</TD></TR><TR><TD>out: </TD><TD>Q</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>MVM_SCRATCH</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>Q,SCRATCH,UNIT_VEC</TD></TR><TR><TD>out: </TD><TD>SCRATCH</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>MVM_Z</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>Z</TD></TR><TR><TD>out: </TD><TD>Z</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>SAVE_SO_SCRATCH</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>—</TD></TR><TR><TD>out: </TD><TD>SO_SCRATCH</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>RESIDUAL_ADD</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>SO_SCRATCH</TD></TR><TR><TD>out: </TD><TD>RES</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>LN1</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>SCRATCH</TD></TR><TR><TD>out: </TD><TD>SCRATCH</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>FFN_GELU</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>LN1</TD></TR><TR><TD>out: </TD><TD>LN1</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>MVM_GELU</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>GELU,RES</TD></TR><TR><TD>out: </TD><TD>GELU</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n8 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>LN2</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>SCRATCH</TD></TR><TR><TD>out: </TD><TD>SCRATCH</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len</FONT></TD></TR></TABLE>>];
  n9 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>SAVE_OUT</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">constant</FONT></TD></TR><TR><TD>in: </TD><TD>—</TD></TR><TR><TD>out: </TD><TD>OUT</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 3</FONT></TD></TR></TABLE>>];
  n10 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>OP_10</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">constant</FONT></TD></TR><TR><TD>in: </TD><TD>—</TD></TR><TR><TD>out: </TD><TD>—</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1</FONT></TD></TR></TABLE>>];
  n11 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>MVM_OUT</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>—</TD></TR><TR><TD>out: </TD><TD>OUT</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len + -1</FONT></TD></TR></TABLE>>];
  n12 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>OP_20</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">x seq_len</FONT></TD></TR><TR><TD>in: </TD><TD>—</TD></TR><TR><TD>out: </TD><TD>—</TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="9">instr = 1 * seq_len + -1</FONT></TD></TR></TABLE>>];
  n0 -> n1 [label="Q"];
  n3 -> n4 [label="SO_SCRATCH"];
  n1 -> n5 [label="SCRATCH"];
  n4 -> n7 [label="RES"];
  n5 -> n8 [label="SCRATCH"];
  n0 -> n0 [label="Q"];
  n8 -> n1 [label="SCRATCH"];
  n2 -> n2 [label="Z"];
  n6 -> n6 [label="LN1"];
  n7 -> n7 [label="GELU"];
}